# constants
NETWORK_NETMASK = "255.255.248.0"
CLUSTER_PREFIX = "vmkube"
ISO_NAME = "metal-amd64.iso"
ISO_URL = f"https://github.com/siderolabs/talos/releases/latest/download/{ISO_NAME}"

# global state
CONFIG = None
SUDO_USER = None
BASE_DIR = None
NETWORK_GATEWAY = None
DHCP_START = None
DHCP_END = None

# colors
RED = "\033[0;31m"
GREEN = "\033[0;32m"
YELLOW = "\033[0;33m"
BLUE = "\033[0;34m"
MAGENTA = "\033[0;35m"
CYAN = "\033[0;36m"
BOLD = "\033[1m"
RESET = "\033[0m"


# logger
def info(msg: str):
    print(f"{BLUE}[INFO]{RESET} {msg}")


def ok(msg: str):
    print(f"{GREEN}[OK]{RESET} {msg}")


def warn(msg: str):
    print(f"{YELLOW}[WARN]{RESET} {msg}")


def error(msg: str):
    print(f"{RED}[ERROR]{RESET} {msg}")


def step(msg: str):
    print(f"\n{CYAN}{BOLD}--- {msg} ---{RESET}")


def die(msg: str):
    error(msg)
    sys.exit(1)


# config
@dataclass
class ControlPlaneNode:
    cpus: int
    ram: int
    system_disk: int


@dataclass
class WorkerNode:
    cpus: int
    ram: int
    system_disk: int
    storage_disk: int


@dataclass
class VirtualNetwork:
    name: str
    bridge: str
    subnet: str


@dataclass
class Config:
    base_dir: str
    cluster_count: int
    worker_nodes_per_cluster: int
    control_plane_nodes_per_cluster: int
    control_plane_node: ControlPlaneNode
    worker_node: WorkerNode
    virtual_network: VirtualNetwork
    local_registries: bool = False


def get_target_username() -> str:
    """Username whose home dir we should use for user-scoped files."""
    return (
        os.environ.get("SUDO_USER")
        or os.environ.get("USER")
        or pwd.getpwuid(os.getuid()).pw_name
    )


def get_user_home(username: str) -> Path:
    return Path(pwd.getpwnam(username).pw_dir)


def get_config_path() -> Path:
    username = get_target_username()
    home = get_user_home(username)
    return home / ".config" / "vmkube.toml"


def load_config():
    """Load configuration from TOML file"""
    config_path = get_config_path()
    try:
        with open(config_path, "rb") as f:
            config_data = tomllib.load(f)

        config = Config(
            base_dir=os.path.expanduser(config_data["base_dir"]),
            cluster_count=config_data["cluster_count"],
            worker_nodes_per_cluster=config_data["worker_nodes_per_cluster"],
            control_plane_nodes_per_cluster=config_data[
                "control_plane_nodes_per_cluster"
            ],
            control_plane_node=ControlPlaneNode(**config_data["control_plane_node"]),
            worker_node=WorkerNode(**config_data["worker_node"]),
            virtual_network=VirtualNetwork(**config_data["virtual_network"]),
            local_registries=config_data.get("local_registries", False),
        )

        info(f"Configuration loaded from {config_path}")
        return config

    except Exception as e:
        die(f"Failed to load config: {e}")


def initconfig(force: bool = False):
    """Generate a default config and write it to ~/.config/vmkube.toml."""
    username = get_target_username()
    home = get_user_home(username)
    config_path = home / ".config" / "vmkube.toml"
    config_dir = config_path.parent

    default_toml = """\
base_dir = "/var/lib/vmkube"  # Base directory for VMKube files and virtual machines
cluster_count = 1  # Number of Kubernetes clusters to create
worker_nodes_per_cluster = 1  # Number of worker nodes per cluster
control_plane_nodes_per_cluster = 1  # Number of control plane nodes per cluster
local_registries = false  # Create local docker registries that proxy to Docker Hub

# Warning! Overcommit is possible for memory and CPU, but not for disk.
[control_plane_node]
cpus = 2  # Number of CPU cores for each control plane node
ram = 2048  # RAM in MB for each control plane node
system_disk = 10  # Disk space in GB for system, Docker images, and ephemeral storage

[worker_node]
cpus = 2  # Number of CPU cores for each worker node
ram = 4096  # RAM in MB for each worker node
system_disk = 15  # Disk space in GB for system, Docker images, and ephemeral storage
storage_disk = 10  # Disk space in GB for Persistent Volume Claims (PVC)

[virtual_network]
name = "vmkube-network"  # Name of the virtual network for the virtual machines
bridge = "vmkube-br0"  # Name of the virtual bridge interface for host-VM communication
subnet = "192.168.192.0"  # Network will use /21 mask (third octet will be 192-199). IPs for VMs and load balancers will be allocated from this subnet
"""

    config_dir.mkdir(parents=True, exist_ok=True)

    if config_path.exists() and not force:
        die(f"Config already exists: {config_path} (use --force to overwrite)")

    config_path.write_text(default_toml)
    config_path.chmod(0o644)

    # If running under sudo, ensure the file belongs to the invoking user
    if os.geteuid() == 0 and os.environ.get("SUDO_USER"):
        shutil.chown(config_dir, username, username)
        shutil.chown(config_path, username, username)

    ok(f"Wrote default config to: {config_path}")


# local registries
def start_caching_registries():
    """Start pull-through caching registries if enabled in config."""
    if not CONFIG.local_registries:
        return

    step("Starting pull-through image cache registries")

    registries = [
        ("docker.io", 5000),
        ("registry.k8s.io", 5001),
        ("gcr.io", 5003),
        ("ghcr.io", 5004),
    ]

    for registry_name, port in registries:
        container_name = f"registry-{registry_name}"

        # Check if container is already running
        result = run_shell(
            [
                "docker",
                "ps",
                "--filter",
                f"name={container_name}",
                "--format",
                "{{.Names}}",
            ],
            check=False,
        )
        if container_name in result.stdout:
            info(f"Caching registry for {registry_name} already running")
            continue

        info(f"Starting caching registry for {registry_name} on port {port}")
        run_shell(
            [
                "docker",
                "run",
                "-d",
                "-p",
                f"{port}:5000",
                "-e",
                f"REGISTRY_PROXY_REMOTEURL=https://{registry_name}",
                "--restart",
                "always",
                "--name",
                container_name,
                "registry:2",
            ],
            check=False,
        )

    ok("Caching registries started")


def remove_caching_registries():
    """Remove pull-through caching registries if enabled."""
    if not CONFIG.local_registries:
        return

    step("Removing pull-through image cache registries")

    registries = ["docker.io", "registry.k8s.io", "gcr.io", "ghcr.io"]

    for registry_name in registries:
        container_name = f"registry-{registry_name}"
        info(f"Removing {container_name}")
        run_shell(["docker", "rm", "-f", container_name], check=False)

    ok("Caching registries removed")


def run_shell(
    cmd: list[str], check: bool = True, verbose: bool = False, **kwargs
) -> subprocess.CompletedProcess:
    """Run a command and return the result."""
    try:
        result = subprocess.run(
            cmd, check=check, capture_output=True, text=True, **kwargs
        )
        if verbose:
            info(f"$ {' '.join(cmd)}")
            if result.stdout.strip():
                info(result.stdout.strip())
        return result
    except subprocess.CalledProcessError as e:
        error(f"Command failed: {' '.join(e.cmd)}")
        if e.stdout and e.stdout.strip():
            error(f"stdout: {e.stdout.strip()}")
        if e.stderr and e.stderr.strip():
            error(f"stderr: {e.stderr.strip()}")
        if check:
            raise
        return e


def need(cmd: str):
    """Check if command exists"""
    if shutil.which(cmd) is None:
        die(f"Missing required command: {cmd}")


def mb2gb(mb: int) -> float:
    """Convert MB to GB"""
    return mb / 1024


def get_network_gateway(config_data):
    subnet = config_data.virtual_network.subnet
    o1, o2, o3, _ = subnet.split(".")
    return f"{o1}.{o2}.{o3}.1"


def get_dhcp_start(config_data):
    subnet = config_data.virtual_network.subnet
    o1, o2, o3, _ = subnet.split(".")
    return f"{o1}.{o2}.{o3}.2"


def get_dhcp_end(config_data):
    """Update DHCP range to exclude all possible VIP addresses."""
    subnet = config_data.virtual_network.subnet
    o1, o2, o3, _ = subnet.split(".")

    if should_enable_vip():
        # Reserve .240-.250 for VIPs, DHCP ends at .239
        return f"{o1}.{o2}.{o3}.239"
    else:
        return f"{o1}.{o2}.{o3}.254"


def get_cluster_vip(cluster_num: int) -> str:
    """Calculate unique VIP address for a specific cluster."""
    if not should_enable_vip():
        return None

    subnet = CONFIG.virtual_network.subnet
    o1, o2, o3, _ = subnet.split(".")

    # Assign VIPs starting from .250 downwards to avoid DHCP conflicts
    # Cluster 1 gets .250, Cluster 2 gets .249, etc.
    vip_octet = 250 - (cluster_num - 1)

    if vip_octet < 240:  # Keep some buffer
        die(f"Too many clusters for VIP allocation. VIP octet would be {vip_octet}")

    return f"{o1}.{o2}.{o3}.{vip_octet}"


def should_enable_vip() -> bool:
    """Check if VIP should be enabled (only for multiple control planes)."""
    return CONFIG.control_plane_nodes_per_cluster > 1


def get_vip_ip(config_data):
    """Calculate VIP address if enabled."""
    if not should_enable_vip():
        return None

    subnet = config_data.virtual_network.subnet
    o1, o2, o3, _ = subnet.split(".")
    return f"{o1}.{o2}.{o3}.253"  # Last usable IP before .254


def create_qemu_disk(size: int, disk_path: str):
    """Create a disk image"""
    run_shell(
        [
            "qemu-img",
            "create",
            "-f",
            "qcow2",
            str(disk_path),
            f"{size}G",
        ]
    )


def require_sudo():
    if os.geteuid() != 0:
        die("Run with sudo!")


def setup_sudo_user():
    global SUDO_USER
    SUDO_USER = os.environ.get("SUDO_USER")
    if not SUDO_USER:
        die("Run via sudo from a normal user (SUDO_USER empty)")


def setup_environment():
    """Setup environment variables and permissions"""
    step("Setting up environment")
    global BASE_DIR, NETWORK_GATEWAY, DHCP_START, DHCP_END

    BASE_DIR = Path(CONFIG.base_dir)
    NETWORK_GATEWAY = get_network_gateway(CONFIG)
    DHCP_START = get_dhcp_start(CONFIG)
    DHCP_END = get_dhcp_end(CONFIG)

    info(f"Base directory: {BASE_DIR}")
    info(f"User: {SUDO_USER}")
    if should_enable_vip():
        # Show VIP range instead of single VIP
        subnet = CONFIG.virtual_network.subnet
        o1, o2, o3, _ = subnet.split(".")
        info(
            f"VIP range: {o1}.{o2}.{o3}.{250 - (CONFIG.cluster_count - 1)}-{o1}.{o2}.{o3}.250"
        )
    else:
        info("VIP: disabled (single control plane)")


def signal_handler(signum, frame):
    """Handle signals for cleanup"""
    print("\n")
    warn("Script interrupted -> cleanup, please wait for a while...")
    down(force=True, remove_all=False)  # Don't remove registries/ISO on interrupt
    sys.exit(1)


def get_all_vm_names() -> set[str]:
    """Get set of all defined VM names."""
    result = run_shell(["virsh", "list", "--all", "--name"], check=False)
    if result.returncode != 0:
        return set()
    return {name.strip() for name in result.stdout.splitlines() if name.strip()}


def destroy_vm(vm_name: str, existing_vms: set[str]):
    """Destroy and undefine a single VM with its storage."""
    if vm_name not in existing_vms:
        info(f"  {vm_name} — already absent, skipping")
        return

    info(f"  {vm_name} — removing...")
    run_shell(["virsh", "destroy", vm_name], check=False)
    run_shell(["virsh", "undefine", vm_name, "--remove-all-storage"], check=False)
    ok(f"  {vm_name} removed")


def cleanup_control_plane_nodes(existing_vms: set[str]):
    """Cleanup all control plane VMs."""
    step("Removing control plane VMs")
    for c in range(1, CONFIG.cluster_count + 1):
        for cp in range(1, CONFIG.control_plane_nodes_per_cluster + 1):
            destroy_vm(f"cp-{c}-{cp}", existing_vms)


def cleanup_worker_nodes(existing_vms: set[str]):
    """Cleanup all worker VMs."""
    step("Removing worker VMs")
    for c in range(1, CONFIG.cluster_count + 1):
        for w in range(1, CONFIG.worker_nodes_per_cluster + 1):
            destroy_vm(f"worker-{c}-{w}", existing_vms)


def remove_virtual_network():
    """Remove the virtual network if it exists."""
    step(f"Removing network: {CONFIG.virtual_network.name}")

    # Check if network exists first
    result = run_shell(["virsh", "net-info", CONFIG.virtual_network.name], check=False)
    if result.returncode != 0:
        info("  Network not found, skipping")
        return

    run_shell(["virsh", "net-destroy", CONFIG.virtual_network.name], check=False)
    run_shell(["virsh", "net-undefine", CONFIG.virtual_network.name], check=False)
    ok(f"  Network {CONFIG.virtual_network.name} removed")


def remove_leftover_bridge():
    """Remove leftover bridge interface if it exists."""
    if not check_bridge_exists():
        return

    info(f"  Removing leftover bridge: {CONFIG.virtual_network.bridge}")
    run_shell(["ip", "link", "set", CONFIG.virtual_network.bridge, "down"], check=False)
    run_shell(
        ["ip", "link", "delete", CONFIG.virtual_network.bridge, "type", "bridge"],
        check=False,
    )


def check_bridge_exists() -> bool:
    """Check if network bridge exists"""
    result = run_shell(
        ["ip", "link", "show", CONFIG.virtual_network.bridge], check=False
    )
    return result.returncode == 0


def print_cleanup_warning(remove_all: bool = False):
    """Print destructive operation warning banner."""
    print()
    print("=" * 60)
    print("⚠️   WARNING: DESTRUCTIVE OPERATION")
    print("=" * 60)
    print("This will destroy ALL VMs, networks, and data associated with:")
    print("  - All control plane VMs (cp-*)")
    print("  - All worker VMs (worker-*)")
    print("  - Virtual network and bridge")
    print("  - All disk images and configuration files")

    if remove_all:
        print("  - Local caching registries (--all flag specified)")
        print("  - Talos ISO image")

    print()
    print("This operation is IRREVERSIBLE!")
    print("=" * 60)
    print()


def cleanup_data_directories():
    """Cleanup data directories."""
    info("Cleaning up data directories...")

    # Remove cluster directories
    if BASE_DIR.exists():
        for item in BASE_DIR.glob(f"{CLUSTER_PREFIX}-*"):
            if item.is_dir():
                info(f"  Removing directory: {item}")
                shutil.rmtree(item, ignore_errors=True)


def cleanup_all_vms_by_pattern():
    """Cleanup VMs by common naming patterns when CONFIG is not available."""
    info("Cleaning up VMs by pattern matching")

    # Try to find and destroy VMs with common patterns
    patterns = ["cp-", "worker-"]

    # Get list of all VMs
    result = run_shell(["virsh", "list", "--all"], check=False)
    if result.returncode == 0:
        for line in result.stdout.splitlines()[2:]:  # Skip header
            if line.strip():
                vm_name = line.split()[1]
                if any(pattern in vm_name for pattern in patterns):
                    destroy_vm(vm_name)


def remove_network_by_default_name():
    """Remove network by common default names."""
    default_networks = ["talos-network", "taloslab", "kube-net"]

    for net_name in default_networks:
        result = run_shell(["virsh", "net-info", net_name], check=False)
        if result.returncode == 0:
            info(f"Removing network: {net_name}")
            run_shell(["virsh", "net-destroy", net_name], check=False)
            run_shell(["virsh", "net-undefine", net_name], check=False)


def setup_permissions():
    """Setup permissions for directories"""
    step("Setting up permissions")

    # Create base directory
    BASE_DIR.mkdir(parents=True, exist_ok=True)

    # Set ownership
    shutil.chown(BASE_DIR, SUDO_USER, SUDO_USER)
    BASE_DIR.chmod(0o755)

    # Determine libvirt user
    libvirt_user = "libvirt-qemu"
    try:
        import pwd

        pwd.getpwnam(libvirt_user)
    except KeyError:
        libvirt_user = "qemu"

    # Set ACLs if available
    if shutil.which("setfacl"):
        run_shell(
            ["setfacl", "-m", f"u:{libvirt_user}:rx", str(BASE_DIR)],
            check=False,
        )
        info(f"ACL set for {libvirt_user}")
    else:
        warn("setfacl not found; falling back to chmod")
        BASE_DIR.chmod(0o755)

    ok("Permissions set")


def calculate_required_resources():
    """Calculate total required resources."""
    cp = CONFIG.control_plane_node
    worker = CONFIG.worker_node

    total_cpu = (
        cp.cpus * CONFIG.control_plane_nodes_per_cluster
        + worker.cpus * CONFIG.worker_nodes_per_cluster
    ) * CONFIG.cluster_count
    total_ram = (
        cp.ram * CONFIG.control_plane_nodes_per_cluster
        + worker.ram * CONFIG.worker_nodes_per_cluster
    ) * CONFIG.cluster_count  # MB
    total_disk = (
        cp.system_disk * CONFIG.control_plane_nodes_per_cluster * CONFIG.cluster_count
    ) + (
        (worker.system_disk + worker.storage_disk)
        * CONFIG.worker_nodes_per_cluster
        * CONFIG.cluster_count
    )

    return total_cpu, total_ram, total_disk


def get_available_cpu():
    """Get available CPU cores."""
    return os.cpu_count()


def get_available_ram():
    """Get available RAM in MB."""
    with open("/proc/meminfo", "r") as f:
        for line in f:
            if line.startswith("MemTotal:"):
                return int(line.split()[1]) // 1024  # Convert kB to MB
    return 0


def get_available_disk():
    """Get available disk space in GB."""
    stat = shutil.disk_usage(BASE_DIR)
    return stat.free // (1024**3)  # Convert to GB


def log_resource_plan(cp, worker, total_cpu, total_ram, total_disk):
    """Log the resource allocation plan."""
    info("=== PLAN ===")
    info(
        f"Clusters: {CONFIG.cluster_count} | Workers/cluster: {CONFIG.worker_nodes_per_cluster}"
    )
    info(
        f"Per control plane node: {cp.cpus} vCPU, {mb2gb(cp.ram):.2f}GB RAM, {cp.system_disk}GB system disk"
    )
    info(
        f"Per worker node: {worker.cpus} vCPU, {mb2gb(worker.ram):.2f}GB RAM, {worker.system_disk}GB system disk + {worker.storage_disk}GB storage disk"
    )
    info("=== TOTAL REQUESTED ===")
    info(f"CPU:  {total_cpu} vCPU")
    info(f"RAM:  {mb2gb(total_ram):.2f}GB")
    info(f"Disk: {total_disk} GB")


def log_available_resources(avail_cpu, avail_ram, avail_disk):
    """Log available system resources."""
    info("=== AVAILABLE ===")
    info(f"CPU cores: {avail_cpu}")
    info(f"RAM:       {mb2gb(avail_ram):.2f}GB")
    info(f"Disk free: {avail_disk} GB (checked at {BASE_DIR})")
    print()


def check_cpu_overcommit(total_cpu, avail_cpu):
    """Check if CPU requested exceeds available."""
    if total_cpu > avail_cpu:
        warn(f"CPU overcommit: requested {total_cpu} vCPU > {avail_cpu} cores")


def check_ram_overcommit(total_ram, avail_ram):
    """Check if RAM requested exceeds available."""
    if total_ram > avail_ram:
        warn(
            f"RAM overcommit: requested {mb2gb(total_ram):.2f}GB > available {mb2gb(avail_ram):.2f}GB"
        )


def check_disk_space(total_disk, avail_disk):
    """Check if disk space requested exceeds available."""
    if total_disk > avail_disk:
        die(f"Insufficient disk: need {total_disk}GB free, have {avail_disk}GB")


def check_kvm_available():
    """Check if KVM is available."""
    if not Path("/dev/kvm").exists():
        die("KVM not available (/dev/kvm missing)")


def check_libvirtd_running():
    """Check if libvirtd service is running."""
    result = run_shell(["systemctl", "is-active", "libvirtd"], check=False)
    if result.returncode != 0:
        die("libvirtd is not running")


def check_resources():
    """Check system resources - main aggregator function."""
    step("Checking system resources")

    cp = CONFIG.control_plane_node
    worker = CONFIG.worker_node

    # Calculate required resources
    total_cpu, total_ram, total_disk = calculate_required_resources()

    # Get available resources
    avail_cpu = get_available_cpu()
    avail_ram = get_available_ram()
    avail_disk = get_available_disk()

    # Log resource information
    log_resource_plan(cp, worker, total_cpu, total_ram, total_disk)
    log_available_resources(avail_cpu, avail_ram, avail_disk)

    # Check for overcommit
    check_cpu_overcommit(total_cpu, avail_cpu)
    check_ram_overcommit(total_ram, avail_ram)
    check_disk_space(total_disk, avail_disk)

    # Check virtualization prerequisites
    check_kvm_available()
    check_libvirtd_running()

    ok("Resource check passed")


def remove_existing_network():
    """Remove existing libvirt network if it exists."""
    result = run_shell(["virsh", "net-info", CONFIG.virtual_network.name], check=False)
    if result.returncode == 0:
        info(f"Destroy/undefine existing network '{CONFIG.virtual_network.name}'")
        run_shell(["virsh", "net-destroy", CONFIG.virtual_network.name], check=False)
        run_shell(["virsh", "net-undefine", CONFIG.virtual_network.name], check=False)


def create_network_xml():
    """Create XML configuration for the libvirt network."""
    network_xml = f"""<network>
  <name>{CONFIG.virtual_network.name}</name>
  <bridge name="{CONFIG.virtual_network.bridge}" stp="off" delay="0"/>
  <forward mode="nat">
    <nat><port start="1024" end="65535"/></nat>
  </forward>
  <ip address="{NETWORK_GATEWAY}" netmask="{NETWORK_NETMASK}">
    <dhcp><range start="{DHCP_START}" end="{DHCP_END}"/></dhcp>
  </ip>
</network>"""
    return network_xml


def write_xml_to_temp_file(xml_content):
    """Write XML content to a temporary file."""
    with tempfile.NamedTemporaryFile(mode="w", suffix=".xml", delete=False) as f:
        f.write(xml_content)
        return f.name


def define_and_start_network(xml_file):
    """Define and start the libvirt network."""
    run_shell(["virsh", "net-define", xml_file])
    run_shell(["virsh", "net-start", CONFIG.virtual_network.name])
    run_shell(["virsh", "net-autostart", CONFIG.virtual_network.name])


def wait_for_dnsmasq_lease_file():
    """Wait for dnsmasq lease file to be created."""
    lease_file = Path(f"/var/lib/libvirt/dnsmasq/{CONFIG.virtual_network.name}.leases")
    for _ in range(20):
        if lease_file.exists():
            break
        time.sleep(1)


def log_network_creation_success():
    """Log successful network creation."""
    ok(
        f"Network active: {CONFIG.virtual_network.name} (bridge={CONFIG.virtual_network.bridge}, gw={NETWORK_GATEWAY}, dhcp={DHCP_START}-{DHCP_END})"
    )


def cleanup_temp_file(xml_file):
    """Clean up temporary XML file."""
    Path(xml_file).unlink(missing_ok=True)


def recreate_network():
    """Recreate libvirt network - main aggregator function."""
    step(f"Recreating libvirt network: {CONFIG.virtual_network.name}")

    remove_existing_network()

    if check_bridge_exists():
        info(f"Removing leftover bridge '{CONFIG.virtual_network.bridge}'")
        remove_leftover_bridge()  # Reuse from earlier refactoring

    network_xml = create_network_xml()
    xml_file = write_xml_to_temp_file(network_xml)

    try:
        define_and_start_network(xml_file)
        log_network_creation_success()
        wait_for_dnsmasq_lease_file()
    finally:
        cleanup_temp_file(xml_file)


def parse_ip_from_domifaddr_output(output: str) -> Optional[str]:
    """Parse IP address from virsh domifaddr output."""
    for line in output.splitlines():
        if "ipv4" in line:
            parts = line.split()
            if len(parts) >= 4:
                ip = parts[3].split("/")[0]
                if ip and not ip.startswith("127."):
                    return ip
    return None


def get_vm_ip_from_source(vm_name: str, source: str) -> Optional[str]:
    """Get VM IP address using a specific source (lease or arp)."""
    result = run_shell(["virsh", "domifaddr", vm_name, "--source", source], check=False)
    if result.returncode == 0:
        return parse_ip_from_domifaddr_output(result.stdout)
    return None


def get_vm_mac_address(vm_name: str) -> Optional[str]:
    """Get MAC address of VM's interface on the virtual network."""
    result = run_shell(["virsh", "domiflist", vm_name], check=False)
    if result.returncode == 0:
        for line in result.stdout.splitlines():
            if CONFIG.virtual_network.name in line:
                parts = line.split()
                if len(parts) >= 5:
                    return parts[4].lower()
    return None


def get_ip_from_dnsmasq_leases(mac_address: str) -> Optional[str]:
    """Find IP address in dnsmasq leases file by MAC address."""
    lease_file = Path(f"/var/lib/libvirt/dnsmasq/{CONFIG.virtual_network.name}.leases")

    if not lease_file.exists():
        return None

    with open(lease_file, "r") as f:
        for lease_line in f:
            parts = lease_line.split()
            if len(parts) >= 3 and parts[1].lower() == mac_address:
                ip = parts[2]
                if ip and not ip.startswith("127."):
                    return ip
    return None


def try_get_vm_ip_lease_source(vm_name: str) -> Optional[str]:
    return get_vm_ip_from_source(vm_name, "lease")


def try_get_vm_ip_arp_source(vm_name: str) -> Optional[str]:
    return get_vm_ip_from_source(vm_name, "arp")


def try_get_vm_ip_dnsmasq_leases(vm_name: str) -> Optional[str]:
    mac_address = get_vm_mac_address(vm_name)
    if mac_address:
        return get_ip_from_dnsmasq_leases(mac_address)
    return None


def attempt_ip_discovery(vm_name: str) -> Optional[str]:
    """Single attempt to discover VM IP using multiple methods."""
    # Try lease source first
    ip = try_get_vm_ip_lease_source(vm_name)
    if ip:
        return ip

    # Try ARP source
    ip = try_get_vm_ip_arp_source(vm_name)
    if ip:
        return ip

    # Try dnsmasq leases
    ip = try_get_vm_ip_dnsmasq_leases(vm_name)
    if ip:
        return ip

    return None


def get_vm_ip(vm_name: str, max_tries: int = 60) -> Optional[str]:
    """Get VM IP address - main aggregator function."""
    for attempt in range(max_tries):
        ip = attempt_ip_discovery(vm_name)
        if ip:
            return ip

        # Wait before next attempt if not the last attempt
        if attempt < max_tries - 1:
            time.sleep(5)

    return None


def retry(func, max_retries: int = 30, sleep_time: int = 10, **kwargs):
    """Retry a function"""
    for i in range(max_retries):
        try:
            return func(**kwargs)
        except Exception as e:
            if i < max_retries - 1:
                info(f"Retry {i + 1}/{max_retries}: {e}")
                time.sleep(sleep_time)
            else:
                raise


