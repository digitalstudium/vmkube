    """Generate Talos configuration files."""
    step(f"Cluster {cluster_num}: generating Talos config")
    cfgdir = BASE_DIR / f"{CLUSTER_PREFIX}-{cluster_num}" / "configs"

    # Get cluster-specific VIP
    cluster_vip = get_cluster_vip(cluster_num)

    # Determine endpoint: cluster VIP if enabled, otherwise single node IP
    if cluster_vip and should_enable_vip():
        endpoint = f"https://{cluster_vip}:6443"
        info(f"Using cluster VIP endpoint: {endpoint}")
    else:
        endpoint = f"https://{cp_ip}:6443"
        info(f"Using single node endpoint: {endpoint}")

    cmd = [
        "talosctl",
        "gen",
        "config",
        f"{CLUSTER_PREFIX}-{cluster_num}",
        endpoint,
        "--install-disk",
        "/dev/vda",
        "-o",
        str(cfgdir),
    ]

    # Add registry mirrors if enabled
    if CONFIG.local_registries:
        network_gateway = get_network_gateway(CONFIG)
        cmd.extend(
            [
                "--registry-mirror",
                f"docker.io=http://{network_gateway}:5000",
                "--registry-mirror",
                f"registry.k8s.io=http://{network_gateway}:5001",
                "--registry-mirror",
                f"gcr.io=http://{network_gateway}:5003",
                "--registry-mirror",
                f"ghcr.io=http://{network_gateway}:5004",
            ]
        )

    # Add VIP patch only for control plane configs if VIP is enabled
    if cluster_vip and should_enable_vip():
        vip_patch = create_vip_patch(cluster_vip)
        with tempfile.NamedTemporaryFile(mode="w", suffix=".yaml", delete=False) as f:
            f.write(vip_patch)
            vip_patch_file = f.name

        cmd.extend(["--config-patch-control-plane", f"@{vip_patch_file}"])

        try:
            run_shell(cmd)
            ok(f"Config generated with VIP {cluster_vip}: {cfgdir}")
        finally:
            Path(vip_patch_file).unlink(missing_ok=True)
    else:
        run_shell(cmd)
        ok(f"Config generated: {cfgdir}")

    # Note: We removed the update_talosconfig_with_endpoints call here
    # We'll configure endpoints after we get the actual IPs


