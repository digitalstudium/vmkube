def bootstrap_cluster(cluster_num: int, cp_ip: str):
    """Bootstrap Talos cluster and get kubeconfig."""
    step(f"Cluster {cluster_num}: bootstrap + kubeconfig")
    cfgdir = BASE_DIR / f"{CLUSTER_PREFIX}-{cluster_num}" / "configs"

    talosconfig = cfgdir / "talosconfig"
    env = os.environ.copy()
    env["TALOSCONFIG"] = str(talosconfig)

    # Use the context we created
    context_name = f"{CLUSTER_PREFIX}-{cluster_num}"

    # Switch to our context
    run_shell(["talosctl", "config", "context", context_name], env=env)

    if not wait_for_port(cp_ip, 50000, 300):
        die(f"Talos API never opened on {cp_ip}")

    retry(
        lambda: run_shell(
            ["talosctl", "--context", context_name, "bootstrap"], env=env
        ),
        max_retries=30,
        sleep_time=10,
    )

    kube_dir = Path(f"/home/{SUDO_USER}/.kube")
    kube_dir.mkdir(parents=True, exist_ok=True)
    kubeconfig_path = kube_dir / CLUSTER_PREFIX

    env["KUBECONFIG"] = str(kubeconfig_path)

    retry(
        lambda: run_shell(
            ["talosctl", "--context", context_name, "kubeconfig"], env=env
        ),
        max_retries=30,
        sleep_time=10,
    )

    shutil.chown(kube_dir, SUDO_USER, SUDO_USER)
    shutil.chown(kubeconfig_path, SUDO_USER, SUDO_USER)

    ok(f"Cluster {cluster_num} bootstrapped")


def check_all_clusters_health(cp_ips: dict):
    """Check health of all clusters."""
    for c in range(1, CONFIG.cluster_count + 1):
        check_cluster_health(c, cp_ips[c])


def print_creation_summary(cp_ips: dict, worker_ips: dict):
    """Print final creation summary with per-cluster VIP info."""
    print()
    ok("CREATION COMPLETE")
    info(f"Network: {CONFIG.virtual_network.name}")
    info(f"Base dir: {BASE_DIR}")

    if should_enable_vip():
        subnet = CONFIG.virtual_network.subnet
        o1, o2, o3, _ = subnet.split(".")
        info(f"VIP range reserved: {o1}.{o2}.{o3}.240-{o1}.{o2}.{o3}.250")

    print("=== Cluster Details ===")

    for c in range(1, CONFIG.cluster_count + 1):
        cluster_vip = get_cluster_vip(c)
        print(f"\nCluster {c}:")

        if cluster_vip and should_enable_vip():
            print(f"  VIP:           {cluster_vip}")

        if c in cp_ips:
            for i, cp_ip in enumerate(cp_ips[c]):
                print(f"  Control plane {i + 1}: {cp_ip}")

        if c in worker_ips:
            print(f"  Workers:       {' '.join(worker_ips[c])}")

        if should_enable_vip():
            print(
                f"  HA Mode:       Enabled ({CONFIG.control_plane_nodes_per_cluster} control planes)"
            )
        else:
            print(f"  HA Mode:       Disabled (single control plane)")


def remove_kubeconfig():
    """Removing kubeconfig"""
    step("Remove kubeconfig")
    kubeconfig = Path(f"/home/{SUDO_USER}/.kube/{CLUSTER_PREFIX}")
    kubeconfig.unlink(missing_ok=True)


def down(force: bool = False, remove_all: bool = False):
    """Cleanup resources."""
    global CONFIG, BASE_DIR
    setup_sudo_user()
    print_cleanup_warning(remove_all)

    if not force:
        confirm = input("Type 'yes' to proceed: ").strip()
        if confirm != "yes":
            info("Cleanup cancelled")
            return

    if CONFIG is None:
        try:
            CONFIG = load_config()
        except Exception as e:
            warn(f"Could not load config: {e}")

    BASE_DIR = Path(CONFIG.base_dir) if CONFIG else None

    # Get VM list ONCE
    existing_vms = get_all_vm_names()

    if CONFIG is not None:
        remove_kubeconfig()
        cleanup_control_plane_nodes(existing_vms)
        cleanup_worker_nodes(existing_vms)
        remove_virtual_network()
        # Remove caching registries only if --all flag is specified
        if remove_all and CONFIG.local_registries:
            remove_caching_registries()
    else:
        cleanup_all_vms_by_pattern()
        remove_network_by_default_name()
        # Only remove caching registries if --all flag is specified
        if remove_all:
            remove_caching_registries()

    remove_leftover_bridge()
    if BASE_DIR:
        cleanup_data_directories()

    # Remove ISO image if --all flag is specified
    if remove_all and BASE_DIR:
        iso_path = BASE_DIR / ISO_NAME
        if iso_path.exists():
            step(f"Removing ISO image: {iso_path}")
            iso_path.unlink(missing_ok=True)
            ok(f"ISO image removed: {iso_path}")

    ok("Cleanup complete!")


def up():
    """Main execution function"""
    global CONFIG
    require_sudo()
    setup_sudo_user()
    CONFIG = load_config()
    setup_environment()
    setup_signal_handlers()

    check_prerequisites()

    # Check for docker if local_registries is enabled
    if CONFIG.local_registries:
        if shutil.which("docker") is None:
            die("Docker is required for local registries but not found")
        info("Local registries enabled - will set up pull-through cache")

    setup_permissions()
    check_resources()
    validate_vip_allocation()

    if not confirm_proceed():
        die("Cancelled")

    ensure_time_sync()
    setup_working_directory()
    download_talos_iso()

    # Start caching registries before creating network
    if CONFIG.local_registries:
        start_caching_registries()

    recreate_network()

    cp_ips, worker_ips = create_and_setup_clusters()

    check_all_clusters_health(cp_ips)
    print_creation_summary(cp_ips, worker_ips)


def main():
    if len(sys.argv) < 2:
        print("Usage: vmkube {up|down|initconfig} [--all|--force]")
        sys.exit(1)

    if sys.argv[1] == "up":
        up()
    elif sys.argv[1] == "down":
        remove_all = "--all" in sys.argv
        down(force=False, remove_all=remove_all)
    elif sys.argv[1] == "initconfig":
        force = "--force" in sys.argv
        initconfig(force=force)
    else:
        print("Invalid action")
        sys.exit(1)


if __name__ == "__main__":
    main()
